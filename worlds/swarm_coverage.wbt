#VRML_SIM R2023b utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/robots/epuck/protos/E-puck.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/RectangleArena.proto"

WorldInfo {
  title "Multi-Agent Swarm Coverage"
  timestep 32
}
Viewpoint {
  orientation -0.5773502691896258 0.5773502691896258 0.5773502691896258 2.0944
  position 0.0 1.2 1.5
}
Background {
  skyColor [ 0.4 0.7 1.0 ]
}
DirectionalLight {
  ambientIntensity 1
  direction 0.2 -1.0 0.5
}
RectangleArena {
  floorSize 3 3
  wallHeight 0.1
}

# Agent 1 (Leader / Explorer)
E-puck {
  translation -1.0 -1.0 0
  rotation 0 0 1 0
  name "agent_1"
  controller "swarm_controller"
  supervisor TRUE
}

# Agent 2 (Collaborator A)
E-puck {
  translation 1.0 -1.0 0
  rotation 0 0 1 1.57
  name "agent_2"
  controller "swarm_controller"
}

# Agent 3 (Collaborator B)
E-puck {
  translation 0.0 1.0 0
  rotation 0 0 1 3.14
  name "agent_3"
  controller "swarm_controller"
}